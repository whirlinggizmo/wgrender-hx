# Compile-check of the whole wgr binding surface (test/CheckBindings.hx), not just the
# part Simple.hx uses. Run ./build.py check — it needs build/desktop.hxml, which
# ./build.py desktop writes. The result is never run.
build/desktop.hxml

-cp src
-cp test
--main CheckBindings
--cpp build/cpp/check

-D HAXE_OUTPUT_FILE=check-bindings
-dce full
