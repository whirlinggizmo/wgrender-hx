# The binding checks (test/CheckBindings.hx), built against headless wgrender — no
# window, GPU or audio — so they can run and assert rather than only compile.
# Run ./build.py check; it writes build/check.hxml and runs the binary.
build/check.hxml

-cp src
-lib wgrender-hx
-cp test
--main CheckBindings
--cpp build/cpp/check

-D HAXE_OUTPUT_FILE=check-bindings
-dce full
