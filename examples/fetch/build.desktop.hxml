# fetch, native: the same guest source through hxcpp, with wgrender compiled into
# the binary. `haxe build.desktop.hxml`; the program looks for assets/ beside itself.
-cp src
-lib wgrender-hx
--main Fetch
--cpp build/cpp/desktop

-D HAXE_OUTPUT_FILE=fetch-guest
-dce full
-D analyzer-optimize
-D WGR_INCLUDE_FETCHER
