# Generated by guestbuild.py. The same guest source, native through hxcpp:
# wgrender and the guest glue are linked into one binary, with no wasm anywhere.
build/desktop.hxml

-cp src
-lib wgrender-hx
--main FlatDemo
--cpp build/cpp/desktop

-D HAXE_OUTPUT_FILE=flat-guest
-dce full
-D analyzer-optimize
