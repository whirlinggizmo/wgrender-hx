<?xml version="1.0" encoding="UTF-8"?>
<!--
  How an installed wgrender-hx finds wgrender.

  Pulled in by the @:buildXml on wgr.impl.Raw when WGR_BUILD_XML is NOT defined,
  which is the case for anyone who ran `haxelib install wgrender-hx`. wgrender comes
  from the submodule under project/lib and is linked as the static library its own
  Makefile builds, rather than compiled from source here: wgrender's build packs
  shaders and vendors sokol, and restating that in hxcpp would be a second build to
  keep in step with the first.

  `haxelib run wgrender-hx setup` is what builds it. hxcpp's Build.xml can test for a
  define but not for a file, so a missing library shows up as a linker error; setup
  is the one step between installing and building.

  A checkout of this repo defines WGR_BUILD_XML instead, pointing at whatever
  wgrender it is working against, so the examples and the test suite never come here.
-->
<xml>
    <pragma once="true" />

    <set name="WGRENDER" value="${haxelib:wgrender-hx}/project/lib/wgrender-c" />
    <set name="WGRHX" value="${haxelib:wgrender-hx}" />

    <!-- hxcpp reads <error> in its top-level parser, not inside <target>, so this
         has to sit out here to fire at all. MSVC is hxcpp's default on Windows and
         is the one combination that cannot work, so say why before the link does. -->
    <error value="wgrender has no MSVC build: its Makefile cross-compiles Windows with MinGW, and link.exe cannot use those objects (they need GCC runtime symbols such as __chkstk_ms). Build wgrender with MinGW and compile with -D mingw -D HXCPP_M64 so both halves match, or cross-compile from Linux with -D windows -D HXCPP_M64."
           if="windows" unless="mingw" />

    <files id="haxe">
        <compilerflag value="-I${WGRENDER}/include" />
        <compilerflag value="-I${WGRHX}/host" />
    </files>

    <!-- The guest ABI glue. hxcpp compiles it, so a native build needs no separate
         C step of its own. -->
    <files id="wgrguest">
        <compilerflag value="-I${WGRENDER}/include" />
        <compilerflag value="-I${WGRHX}/host" />
        <file name="${WGRHX}/host/wgr_guest.c" />
    </files>

    <target id="haxe">
        <files id="wgrguest" />

        <!-- Library path and link flags per platform, taken from wgrender's own
             examples/Makefile (LDLIBS_PLATFORM, and BUILD_DESKTOP for the path).
             `make -C wgrender-c/examples print-ldlibs [WINDOWS=1]` prints them, which
             is where these came from rather than from memory.

             Linux is verified end to end. macOS carries the flags wgrender links its
             own examples with and nobody has built it.

             Windows does not work yet, and the reason is specific. Tried on Windows
             11 with VS 2019 (MSVC 14.29) and hxcpp 4.3.2 against wgrender's
             build/windows/libwgrender.a: link.exe reads the GNU ar archive and
             resolves every one of wgrender's own symbols, then fails on six GCC
             runtime references the MinGW objects carry, __chkstk_ms and __imp__assert
             among them. So it is not the archive format and not name mangling; it is
             that MinGW objects want GCC's runtime and MSVC does not supply it.

             Two ways out, neither taken here: wgrender grows an MSVC build (its
             Makefile cross-compiles Windows with MinGW only), or the consumer runs
             hxcpp in MinGW mode so both halves come from the same toolchain.

             Also note hxcpp defaults to a 32-bit build on Windows, so an x64
             wgrender needs -D HXCPP_M64 or link.exe reports a machine type conflict
             before it gets as far as any of the above. -->

        <lib name="${WGRENDER}/build/webgl2-nothreads/libwgrender.a" if="emscripten" />

        <section unless="emscripten">
            <!-- Linux -->
            <section if="linux">
                <lib name="${WGRENDER}/build/desktop/libwgrender.a" />
                <lib name="-lGL" />
                <lib name="-lX11" />
                <lib name="-lXi" />
                <lib name="-lXcursor" />
                <lib name="-lXrandr" />
                <lib name="-lasound" />
                <lib name="-ldl" />
                <lib name="-lm" />
                <lib name="-lpthread" />
            </section>

            <!-- Windows. The flag syntax follows the toolchain, not the platform:
                 hxcpp defines `windows` for an MSVC build as well, and passing
                 -lopengl32 to link.exe gets "unrecognized option '/lopengl32'". -->
            <section if="windows">
                <section if="mingw">
                    <lib name="${WGRENDER}/build/windows/libwgrender.a" />
                    <lib name="-static" />
                    <lib name="-lopengl32" />
                    <lib name="-lgdi32" />
                    <lib name="-luser32" />
                    <lib name="-lkernel32" />
                    <lib name="-lole32" />
                    <lib name="-lshell32" />
                    <lib name="-lwinmm" />
                </section>
            </section>

            <!-- macOS: OpenGL, not Metal. sokol is built with SOKOL_GLCORE here. -->
            <section if="macos">
                <lib name="${WGRENDER}/build/desktop/libwgrender.a" />
                <flag value="-framework" />
                <flag value="Cocoa" />
                <flag value="-framework" />
                <flag value="QuartzCore" />
                <flag value="-framework" />
                <flag value="OpenGL" />
                <flag value="-framework" />
                <flag value="AudioToolbox" />
            </section>
        </section>
    </target>
</xml>
