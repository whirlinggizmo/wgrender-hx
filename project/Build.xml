<?xml version="1.0" encoding="UTF-8"?>
<!--
  How an installed wgrender-hx builds wgrender.

  Pulled in by the @:buildXml on wgr.impl.Raw when WGR_BUILD_XML is NOT defined,
  which is the case for anyone who ran `haxelib git wgrender-hx`. wgrender comes from
  the submodule under project/lib and its C sources are compiled here, by whichever
  toolchain hxcpp chose (gcc or clang, MinGW, or MSVC, hxcpp's default on Windows),
  rather than linked from a prebuilt library: MinGW objects and MSVC's linker don't
  mix, and compiling from source means both halves come from one toolchain
  everywhere, with nothing to build first.

  wgrender allows this by asking for nothing at build time: its shader headers are
  committed, its dependencies are vendored, and Python regenerates shaders rather
  than building. project/wgrender.xml lists the sources, from wgrender's build.json,
  and is generated by tools/gen_sources.py; its check mode fails when wgrender gains
  or loses one.

  A checkout of this repo defines WGR_BUILD_XML instead, pointing at whatever
  wgrender it is working against, and links the library that checkout built.
-->
<xml>
    <pragma once="true" />

    <!-- Which wgrender. -D WGRENDER_DIR names one; without it, the submodule that
         came with this library. That define is the whole of what a build has to say,
         which is why the examples no longer generate a build file of their own. -->
    <set name="WGRENDER" value="${WGRENDER_DIR}" if="WGRENDER_DIR" />
    <set name="WGRENDER" value="${haxelib:wgrender-hx}/project/lib/wgrender-c" unless="WGRENDER_DIR" />
    <set name="WGRHX" value="${haxelib:wgrender-hx}" />

    <include name="${haxelib:wgrender-hx}/project/wgrender.xml" />

    <files id="haxe">
        <compilerflag value="-I${WGRENDER}/include" />
        <compilerflag value="-I${WGRHX}/host" />
    </files>

    <!-- The same flags again, because hxcpp compiles the entry class's __main__.cpp as
         its own group rather than as part of `haxe`, and a group gets only the flags
         named for it. It matters as soon as an app's own class names a type the
         binding maps to a wgrender struct -- `KeyboardState` is one, so a `static
         function f(keys:KeyboardState)` puts `#include "wgr.h"` in that class's
         generated header, which __main__.cpp then includes. The examples/2d port is
         where that first happened; before it, every entry class happened to use only
         types that are Int underneath. -->
    <files id="__main__">
        <compilerflag value="-I${WGRENDER}/include" />
        <compilerflag value="-I${WGRHX}/host" />
    </files>

    <!-- The guest ABI glue. hxcpp compiles it, so a native build needs no separate
         C step of its own. -->
    <files id="wgrguest">
        <compilerflag value="-I${WGRENDER}/include" />
        <compilerflag value="-I${WGRHX}/host" />
        <file name="${WGRHX}/host/wgr_guest.c" />
    </files>

    <target id="haxe">
        <files id="wgrguest" />

        <!-- Library path and link flags per platform: wgrender's build.json lists
             them (desktop.<os>.libs, and frameworks on macOS), for gcc and clang as
             -l<name> and for MSVC as <name>.lib. Linux and Windows (MinGW and MSVC)
             are built and run; macOS carries the flags wgrender links its own
             examples with and nobody has built it.

             hxcpp defaults to a 32-bit build on Windows, so add -D HXCPP_M64 for
             x64. -->

        <lib name="${WGRENDER}/build/webgl2-nothreads/libwgrender.a" if="emscripten" />

        <files id="wgrender" />

        <section unless="emscripten">
            <!-- Only the platform libraries: wgrender itself is compiled above, by
                 whichever toolchain hxcpp chose, so there is no archive to match.
                 Flag syntax follows the toolchain rather than the platform, because
                 hxcpp defines `windows` for an MSVC build too and link.exe answers
                 -lopengl32 with "unrecognized option '/lopengl32'". -->
            <section if="linux">
                <lib name="-lGL" />
                <lib name="-lX11" />
                <lib name="-lXi" />
                <lib name="-lXcursor" />
                <lib name="-lXrandr" />
                <lib name="-lasound" />
                <lib name="-ldl" />
                <lib name="-lm" />
                <lib name="-lpthread" />
            </section>

            <section if="windows">
                <section if="mingw">
                    <lib name="-lopengl32" />
                    <lib name="-lgdi32" />
                    <lib name="-luser32" />
                    <lib name="-lkernel32" />
                    <lib name="-lole32" />
                    <lib name="-lshell32" />
                    <lib name="-lwinmm" />
                </section>
                <section unless="mingw">
                    <lib name="opengl32.lib" />
                    <lib name="gdi32.lib" />
                    <lib name="user32.lib" />
                    <lib name="kernel32.lib" />
                    <lib name="ole32.lib" />
                    <lib name="shell32.lib" />
                    <lib name="winmm.lib" />
                </section>
            </section>

            <!-- macOS: OpenGL, not Metal. sokol is built with SOKOL_GLCORE here. -->
            <section if="macos">
                <flag value="-framework" />
                <flag value="Cocoa" />
                <flag value="-framework" />
                <flag value="QuartzCore" />
                <flag value="-framework" />
                <flag value="OpenGL" />
                <flag value="-framework" />
                <flag value="AudioToolbox" />
            </section>
        </section>
    </target>
</xml>
