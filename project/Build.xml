<?xml version="1.0" encoding="UTF-8"?>
<!--
  How an installed wgrender-hx builds wgrender.

  Pulled in by the @:buildXml on wgr.impl.Raw when WGR_BUILD_XML is NOT defined,
  which is the case for anyone who ran `haxelib git wgrender-hx`. wgrender comes from
  the submodule under project/lib and its C sources are compiled here, by whichever
  toolchain hxcpp chose, rather than linked from a library its Makefile built.

  That is what makes Windows work. hxcpp uses MSVC there by default; wgrender's
  Makefile only cross-compiles Windows with MinGW, and link.exe cannot use MinGW
  objects because they need GCC runtime symbols it does not provide. Compiling from
  source sidesteps the question: both halves come from one toolchain everywhere. It
  also means `haxelib run wgrender-hx setup` needs no `make`, which is the other
  thing that stopped Windows before it started.

  wgrender allows this by asking for nothing at build time: its shader headers are
  committed, its dependencies are vendored, and Python regenerates shaders rather
  than building. project/wgrender.xml lists the sources and is generated by
  tools/gen_sources.py; its check mode fails when wgrender gains or loses one.

  A checkout of this repo defines WGR_BUILD_XML instead, pointing at whatever
  wgrender it is working against, and links the library that checkout built.
-->
<xml>
    <pragma once="true" />

    <set name="WGRENDER" value="${haxelib:wgrender-hx}/project/lib/wgrender-c" />
    <set name="WGRHX" value="${haxelib:wgrender-hx}" />

    <include name="${haxelib:wgrender-hx}/project/wgrender.xml" />

    <files id="haxe">
        <compilerflag value="-I${WGRENDER}/include" />
        <compilerflag value="-I${WGRHX}/host" />
    </files>

    <!-- The guest ABI glue. hxcpp compiles it, so a native build needs no separate
         C step of its own. -->
    <files id="wgrguest">
        <compilerflag value="-I${WGRENDER}/include" />
        <compilerflag value="-I${WGRHX}/host" />
        <file name="${WGRHX}/host/wgr_guest.c" />
    </files>

    <target id="haxe">
        <files id="wgrguest" />

        <!-- Library path and link flags per platform, taken from wgrender's own
             examples/Makefile (LDLIBS_PLATFORM, and BUILD_DESKTOP for the path).
             `make -C wgrender-c/examples print-ldlibs [WINDOWS=1]` prints them, which
             is where these came from rather than from memory.

             Linux is verified end to end. macOS carries the flags wgrender links its
             own examples with and nobody has built it.

             Windows does not work yet, and the reason is specific. Tried on Windows
             11 with VS 2019 (MSVC 14.29) and hxcpp 4.3.2 against wgrender's
             build/windows/libwgrender.a: link.exe reads the GNU ar archive and
             resolves every one of wgrender's own symbols, then fails on six GCC
             runtime references the MinGW objects carry, __chkstk_ms and __imp__assert
             among them. So it is not the archive format and not name mangling; it is
             that MinGW objects want GCC's runtime and MSVC does not supply it.

             Two ways out, neither taken here: wgrender grows an MSVC build (its
             Makefile cross-compiles Windows with MinGW only), or the consumer runs
             hxcpp in MinGW mode so both halves come from the same toolchain.

             Also note hxcpp defaults to a 32-bit build on Windows, so an x64
             wgrender needs -D HXCPP_M64 or link.exe reports a machine type conflict
             before it gets as far as any of the above. -->

        <lib name="${WGRENDER}/build/webgl2-nothreads/libwgrender.a" if="emscripten" />

        <files id="wgrender" />

        <section unless="emscripten">
            <!-- Only the platform libraries: wgrender itself is compiled above, by
                 whichever toolchain hxcpp chose, so there is no archive to match.
                 Flag syntax follows the toolchain rather than the platform, because
                 hxcpp defines `windows` for an MSVC build too and link.exe answers
                 -lopengl32 with "unrecognized option '/lopengl32'". -->
            <section if="linux">
                <lib name="-lGL" />
                <lib name="-lX11" />
                <lib name="-lXi" />
                <lib name="-lXcursor" />
                <lib name="-lXrandr" />
                <lib name="-lasound" />
                <lib name="-ldl" />
                <lib name="-lm" />
                <lib name="-lpthread" />
            </section>

            <section if="windows">
                <section if="mingw">
                    <lib name="-lopengl32" />
                    <lib name="-lgdi32" />
                    <lib name="-luser32" />
                    <lib name="-lkernel32" />
                    <lib name="-lole32" />
                    <lib name="-lshell32" />
                    <lib name="-lwinmm" />
                </section>
                <section unless="mingw">
                    <lib name="opengl32.lib" />
                    <lib name="gdi32.lib" />
                    <lib name="user32.lib" />
                    <lib name="kernel32.lib" />
                    <lib name="ole32.lib" />
                    <lib name="shell32.lib" />
                    <lib name="winmm.lib" />
                </section>
            </section>

            <!-- macOS: OpenGL, not Metal. sokol is built with SOKOL_GLCORE here. -->
            <section if="macos">
                <flag value="-framework" />
                <flag value="Cocoa" />
                <flag value="-framework" />
                <flag value="QuartzCore" />
                <flag value="-framework" />
                <flag value="OpenGL" />
                <flag value="-framework" />
                <flag value="AudioToolbox" />
            </section>
        </section>
    </target>
</xml>
